{
  "expo": {
    "name": "Klinik Suel Motor",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.motorservicehub.ij3mml",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcode suku cadang untuk cari stok cepat",
        "NSPhotoLibraryUsageDescription": "Pilih logo bengkel dari galeri untuk nota"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.motorservicehub.ij3mml",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-vector-icons/ionicons",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan barcode suku cadang untuk cari stok cepat"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih logo bengkel dari galeri untuk nota"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
